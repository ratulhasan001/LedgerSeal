# Address of the deployed FileStorage contract
VITE_CONTRACT_ADDRESS=

# RPC used for read-only access when no browser wallet is installed
VITE_RPC_URL=http://127.0.0.1:8545

# Pinata credentials: set either a JWT (preferred) or an API key pair
VITE_PINATA_JWT=
VITE_PINATA_API_KEY=
VITE_PINATA_SECRET_API_KEY=

# Gateway used to build links to uploaded files
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
